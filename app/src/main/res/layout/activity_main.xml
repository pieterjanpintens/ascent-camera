<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The backdrop of the game's begin-campaign page, darkened so the cards stay readable. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/backdrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:adjustViewBounds="true"
                android:contentDescription="Ascent"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/cinzel"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:text="Table Camera"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <ImageView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:adjustViewBounds="true"
                android:alpha="0.7"
                android:importantForAccessibility="no"
                android:src="@drawable/divider" />

            <!-- Status -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/status_dot" />

                    <TextView
                        android:id="@+id/status_title"
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/start_stop"
                    style="@style/AscentButton.Primary"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <!-- Connection details for Ascent -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect Ascent" />

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Address" />

                <TextView
                    android:id="@+id/address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/code_box"
                    android:fontFamily="monospace"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text"
                    android:textIsSelectable="true"
                    android:textSize="22sp" />

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Pairing code" />

                <TextView
                    android:id="@+id/code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/code_box"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.3"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/gold"
                    android:textIsSelectable="true"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/new_code"
                    style="@style/AscentButton"
                    android:text="New pairing code" />
            </LinearLayout>

            <!-- Test photo -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check the framing" />

                <Button
                    android:id="@+id/test_photo"
                    style="@style/AscentButton"
                    android:text="Take a test photo" />

                <TextView
                    android:id="@+id/test_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Last test photo" />
            </LinearLayout>

            <!-- Battery -->
            <LinearLayout
                android:id="@+id/battery_card"
                style="@style/Card">

                <TextView
                    style="@style/Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Screen off" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Android may put the app to sleep while the screen is off. Allow it to keep running, and on Samsung phones also set its battery use to Unrestricted (Settings, Apps, Ascent Camera, Battery)."
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/battery"
                    style="@style/AscentButton"
                    android:text="Allow running with the screen off" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Start the camera, lock the phone and put it in its holder. The camera only switches on for a moment when Ascent asks for a photo."
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
