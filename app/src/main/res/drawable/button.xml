<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#73332666" />
            <stroke android:width="1dp" android:color="#8047387F" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_button_pressed" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_button" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</selector>
