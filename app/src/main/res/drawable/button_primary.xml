<?xml version="1.0" encoding="utf-8"?>
<!-- The big Start/Stop button: the game's orange accent with a gold edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/accent_dark" android:endColor="@color/accent" />
            <stroke android:width="1dp" android:color="@color/gold" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/accent_light" android:endColor="@color/accent_dark" />
            <stroke android:width="1dp" android:color="@color/gold" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
